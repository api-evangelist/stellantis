                        "Enabled",
                        "Disabled",
                        "Finished",
                        "Failure"
                      ]
                    },
                    "startingCause": {
                      "description": "starting cause",
                      "type": "string",
                      "enum": [
                        "Immediate",
                        "Scheduled"
                      ]
                    },
                    "failureCause": {
                      "description": "failure cause",
                      "type": "string",
                      "enum": [
                        "Defect",
                        "DoorOpened",
                        "LowBattery",
                        "LowFuelLevel",
                        "TooManyUnusedProg",
                        "WindowsRoofOpened",
                        "HoodOpened",
                        "NotParked",
                        "OtherFailures"
                      ]
                    },
                    "programs": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "$ref": "#/$defs/PreconditioningProgram"
