      "description": "Expresses all light, direction (```Left```, ```Right``` ),  position (```Front```, ```Rear``` ) and status  (```Off```, ```On```) for a category.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "Left",
              "Right"
            ]
          },
          "position": {
            "type": "string",
            "enum": [
              "Front",
              "Rear"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              false,
              true
            ]
          }
        }
      }
