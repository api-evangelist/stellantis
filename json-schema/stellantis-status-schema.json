      "type": "object",
      "description": "Describe recurring action.",
      "properties": {
        "recurrence": {
          "description": "Determines the recurrence of the program. \n* None: means no recurrence. \n* Daily: repeated over the week. \n",
          "type": "string",
          "enum": [
            "None",
            "Daily"
          ],
          "default": "Daily"
        },
        "start": {
          "type": "string",
          "description": "The program start time formatted using the duration format based on [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601#Time_intervals) with the schema: P[n]Y[n]M[n]DT[n]H[n]M[n]S\n\n_example_: \n\n* PT14H30M means 14H and 30Min\n"
        },
        "occurence": {
          "type": "object",
          "description": "The occurrence on the program will spread on days depending on recurrence value.\n",
          "properties": {
            "day": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Mon",
                  "Tue",
                  "Wed",
                  "Thu",
                  "Fri",
                  "Sat",
                  "Sun"
                ]
              }
            }
          },
          "required": [
            "day"
          ]
        }
      },
      "required": [
        "start"
      ]
    },
